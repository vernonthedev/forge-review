    "@forge-review/llm": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "oxlint": "^0.11.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}